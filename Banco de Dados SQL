REVOKE EXECUTE ON PROCEDURE sp_finalizar_venda(BIGINT)  FROM PUBLIC;
REVOKE EXECUTE ON PROCEDURE sp_cancelar_venda(BIGINT)   FROM PUBLIC;
REVOKE EXECUTE ON PROCEDURE sp_receber_compra(BIGINT)   FROM PUBLIC;
REVOKE EXECUTE ON PROCEDURE sp_registrar_ajuste_estoque(BIGINT, BIGINT, VARCHAR, NUMERIC, VARCHAR) FROM PUBLIC;
