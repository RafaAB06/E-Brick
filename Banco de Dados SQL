-- ------------------------------------------------------------
CREATE ROLE grp_admin     NOLOGIN;
CREATE ROLE grp_gerente   NOLOGIN;
CREATE ROLE grp_vendedor  NOLOGIN;
CREATE ROLE grp_estoque   NOLOGIN;
CREATE ROLE grp_atendente NOLOGIN;
CREATE ROLE grp_backup    NOLOGIN;

-- ------------------------------------------------------------
-- 2. Usuários com os login)
-- ------------------------------------------------------------
CREATE ROLE usr_admin     LOGIN PASSWORD 'pepinos'    IN ROLE grp_admin;
CREATE ROLE usr_gerente   LOGIN PASSWORD 'pepinos'  IN ROLE grp_gerente;
CREATE ROLE usr_vendedor  LOGIN PASSWORD 'pepinos' IN ROLE grp_vendedor;
CREATE ROLE usr_estoque   LOGIN PASSWORD 'pepinos'  IN ROLE grp_estoque;
CREATE ROLE usr_atendente LOGIN PASSWORD 'pepinos'    IN ROLE grp_atendente;
CREATE ROLE usr_backup    LOGIN PASSWORD 'pepinos'   IN ROLE grp_backup;

-- backup lê tudo (somente leitura), sem ser superusuário
GRANT pg_read_all_data TO grp_backup;

-- ------------------------------------------------------------
-- 3. CONEXÃO E SCHEMA
-- ------------------------------------------------------------
GRANT CONNECT ON DATABASE ebrick
    TO grp_admin, grp_gerente, grp_vendedor, grp_estoque, grp_atendente, grp_backup;

GRANT USAGE ON SCHEMA public
    TO grp_admin, grp_gerente, grp_vendedor, grp_estoque, grp_atendente, grp_backup;

-- ------------------------------------------------------------
-- 4. PRIVILÉGIOS EM TABELAS E VIEWS
-- ------------------------------------------------------------

-- 4.1 ADMIN: tudo
GRANT ALL ON ALL TABLES    IN SCHEMA public TO grp_admin;
GRANT ALL ON ALL SEQUENCES IN SCHEMA public TO grp_admin;

-- 4.2 GERENTE: lê tudo (menos credenciais); escreve no operacional; DELETE só em itens
GRANT SELECT ON ALL TABLES IN SCHEMA public TO grp_gerente;
REVOKE ALL ON usuario FROM grp_gerente;          -- senha_hash nunca exposto
GRANT INSERT, UPDATE ON
    categoria, unidade_medida, produto, fornecedor,
    cliente, pessoa_fisica, pessoa_juridica,
    compra, item_compra, venda, item_venda, pagamento
TO grp_gerente;
GRANT DELETE ON item_compra, item_venda TO grp_gerente;

-- 4.3 VENDEDOR (sem acesso a compras, fornecedores e usuários)
GRANT SELECT ON
    categoria, unidade_medida, produto, estoque,
    cliente, pessoa_fisica, pessoa_juridica,
    venda, item_venda, pagamento,
    vw_estoque, vw_vendas, vw_venda_itens,
    vw_pagamentos_por_venda, vw_clientes_completo
TO grp_vendedor;
GRANT INSERT, UPDATE ON
    cliente, pessoa_fisica, pessoa_juridica,
    venda, item_venda, pagamento
TO grp_vendedor;
GRANT DELETE ON item_venda TO grp_vendedor;

-- 4.4 ESTOQUE (controle de estoque e compras)
GRANT SELECT ON
    categoria, unidade_medida, produto, fornecedor,
    estoque, movimentacao_estoque, compra, item_compra,
    vw_estoque, vw_estoque_baixo, vw_compras,
    vw_compras_por_fornecedor, vw_movimentacao_detalhada
TO grp_estoque;
GRANT INSERT, UPDATE ON fornecedor, compra, item_compra TO grp_estoque;
GRANT DELETE ON item_compra TO grp_estoque;

-- 4.5 ATENDENTE (cadastro e consulta de clientes)
GRANT SELECT ON
    cliente, pessoa_fisica, pessoa_juridica, vw_clientes_completo,
    categoria, unidade_medida, produto, vw_estoque
TO grp_atendente;
GRANT INSERT, UPDATE ON cliente, pessoa_fisica, pessoa_juridica TO grp_atendente;


