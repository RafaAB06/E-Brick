-- ============================================================
-- 21. FUNÇÃO DE LOGIN
-- ============================================================

CREATE OR REPLACE FUNCTION fn_autenticar_usuario(
    p_login VARCHAR,
    p_senha TEXT
)
RETURNS TABLE (
    id_usuario BIGINT,
    nome VARCHAR,
    login VARCHAR,
    perfil VARCHAR
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_id_usuario BIGINT;
BEGIN

    SELECT u.id_usuario
    INTO v_id_usuario
    FROM usuario u
    JOIN funcionario f
        ON f.id_funcionario = u.id_funcionario
    WHERE LOWER(u.login) = LOWER(p_login)
      AND u.ativo = TRUE
      AND f.ativo = TRUE
      AND u.senha_hash = crypt(p_senha, u.senha_hash)
    LIMIT 1;

    IF v_id_usuario IS NULL THEN
        RETURN;
    END IF;

    UPDATE usuario
    SET ultimo_login = CURRENT_TIMESTAMP
    WHERE usuario.id_usuario = v_id_usuario;

    RETURN QUERY
    SELECT
        u.id_usuario,
        f.nome,
        u.login,
        COALESCE(
            STRING_AGG(
                p.nome,
                ', '
                ORDER BY p.nome
            ),
            'SEM PERFIL'
        )::VARCHAR AS perfil
    FROM usuario u

    JOIN funcionario f
        ON f.id_funcionario = u.id_funcionario

    LEFT JOIN usuario_perfil up
        ON up.id_usuario = u.id_usuario

    LEFT JOIN perfil p
        ON p.id_perfil = up.id_perfil

    WHERE u.id_usuario = v_id_usuario

    GROUP BY
        u.id_usuario,
        f.nome,
        u.login;

END;
$$;


-- ============================================================
-- 22. FUNÇÃO PARA VERIFICAR PERMISSÃO
-- ============================================================

CREATE OR REPLACE FUNCTION fn_usuario_tem_permissao(
    p_id_usuario BIGINT,
    p_permissao VARCHAR
)
RETURNS BOOLEAN
LANGUAGE plpgsql
AS $$
DECLARE
    v_existe BOOLEAN;
BEGIN

    SELECT EXISTS (
        SELECT 1

        FROM usuario_perfil up

        JOIN perfil_permissao pp
            ON pp.id_perfil = up.id_perfil

        JOIN permissao p
            ON p.id_permissao = pp.id_permissao

        WHERE up.id_usuario = p_id_usuario
          AND p.nome = p_permissao
    )
    INTO v_existe;

    RETURN v_existe;

END;
$$;


-- ============================================================
-- 23. FUNÇÃO DE ENTRADA DE COMPRA NO ESTOQUE
-- ============================================================

CREATE OR REPLACE FUNCTION fn_processar_entrada_compra()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
DECLARE
    v_item RECORD;
BEGIN

    FOR v_item IN
        SELECT
            id_item_compra,
            id_produto,
            quantidade

        FROM item_compra

        WHERE id_compra = NEW.id_compra
    LOOP

        IF NOT EXISTS (
            SELECT 1
            FROM movimentacao_estoque
            WHERE id_item_compra = v_item.id_item_compra
        ) THEN

            INSERT INTO estoque (
                id_produto,
                quantidade_atual
            )

            VALUES (
                v_item.id_produto,
                v_item.quantidade
            )

            ON CONFLICT (id_produto)
            DO UPDATE
            SET quantidade_atual =
                estoque.quantidade_atual
                + EXCLUDED.quantidade_atual;


            INSERT INTO movimentacao_estoque (
                id_produto,
                id_usuario,
                tipo,
                quantidade,
                motivo,
                id_item_compra
            )

            VALUES (
                v_item.id_produto,
                NEW.id_usuario,
                'ENTRADA_COMPRA',
                v_item.quantidade,
                'Entrada referente à compra '
                    || NEW.id_compra,
                v_item.id_item_compra
            );

        END IF;

    END LOOP;

    RETURN NEW;

END;
$$;


-- ============================================================
-- 24. TRIGGER DA COMPRA
-- ============================================================

CREATE TRIGGER trg_compra_recebida

AFTER UPDATE OF status

ON compra

FOR EACH ROW

WHEN (
    NEW.status = 'RECEBIDA'
    AND OLD.status IS DISTINCT FROM 'RECEBIDA'
)

EXECUTE FUNCTION fn_processar_entrada_compra();


-- ============================================================
-- 25. FUNÇÃO DE SAÍDA DE VENDA DO ESTOQUE
-- ============================================================

CREATE OR REPLACE FUNCTION fn_processar_saida_venda()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
DECLARE
    v_item RECORD;
    v_saldo NUMERIC(12,3);
BEGIN

    FOR v_item IN

        SELECT
            id_item_venda,
            id_produto,
            quantidade

        FROM item_venda

        WHERE id_venda = NEW.id_venda

    LOOP

        INSERT INTO estoque (
            id_produto,
            quantidade_atual
        )

        VALUES (
            v_item.id_produto,
            0
        )

        ON CONFLICT (id_produto)
        DO NOTHING;


        SELECT quantidade_atual
        INTO v_saldo

        FROM estoque

        WHERE id_produto = v_item.id_produto

        FOR UPDATE;


        IF v_saldo < v_item.quantidade THEN

            RAISE EXCEPTION
                'Estoque insuficiente para o produto ID %. Estoque atual: %, solicitado: %',
                v_item.id_produto,
                v_saldo,
                v_item.quantidade;

        END IF;


        IF NOT EXISTS (
            SELECT 1

            FROM movimentacao_estoque

            WHERE id_item_venda =
                  v_item.id_item_venda
        ) THEN

            UPDATE estoque

            SET quantidade_atual =
                quantidade_atual - v_item.quantidade

            WHERE id_produto =
                  v_item.id_produto;


            INSERT INTO movimentacao_estoque (
                id_produto,
                id_usuario,
                tipo,
                quantidade,
                motivo,
                id_item_venda
            )

            VALUES (
                v_item.id_produto,
                NEW.id_usuario,
                'SAIDA_VENDA',
                v_item.quantidade,
                'Saída referente à venda '
                    || NEW.id_venda,
                v_item.id_item_venda
            );

        END IF;

    END LOOP;

    RETURN NEW;

END;
$$;


-- ============================================================
-- 26. TRIGGER DA VENDA
-- ============================================================

CREATE TRIGGER trg_venda_finalizada

AFTER UPDATE OF status

ON venda

FOR EACH ROW

WHEN (
    NEW.status = 'FINALIZADA'
    AND OLD.status IS DISTINCT FROM 'FINALIZADA'
)

EXECUTE FUNCTION fn_processar_saida_venda();


-- ============================================================
-- 27. FUNÇÃO PARA AJUSTES, PERDAS E AVARIAS
-- ============================================================

CREATE OR REPLACE FUNCTION fn_registrar_ajuste_estoque(
    p_id_produto BIGINT,
    p_id_usuario BIGINT,
    p_tipo VARCHAR,
    p_quantidade NUMERIC,
    p_motivo VARCHAR
)
RETURNS VOID
LANGUAGE plpgsql
AS $$
DECLARE
    v_saldo NUMERIC(12,3);
BEGIN

    IF p_quantidade <= 0 THEN
        RAISE EXCEPTION
            'A quantidade deve ser maior que zero.';
    END IF;


    IF p_tipo NOT IN (
        'AJUSTE_ENTRADA',
        'AJUSTE_SAIDA',
        'SAIDA_PERDA',
        'SAIDA_AVARIA'
    ) THEN

        RAISE EXCEPTION
            'Tipo de ajuste inválido.';

    END IF;


    INSERT INTO estoque (
        id_produto,
        quantidade_atual
    )

    VALUES (
        p_id_produto,
        0
    )

    ON CONFLICT (id_produto)
    DO NOTHING;


    SELECT quantidade_atual
    INTO v_saldo

    FROM estoque

    WHERE id_produto = p_id_produto

    FOR UPDATE;


    IF p_tipo IN (
        'AJUSTE_SAIDA',
        'SAIDA_PERDA',
        'SAIDA_AVARIA'
    ) THEN

        IF v_saldo < p_quantidade THEN

            RAISE EXCEPTION
                'Estoque insuficiente. Estoque atual: %',
                v_saldo;

        END IF;


        UPDATE estoque

        SET quantidade_atual =
            quantidade_atual - p_quantidade

        WHERE id_produto =
              p_id_produto;

    ELSE

        UPDATE estoque

        SET quantidade_atual =
            quantidade_atual + p_quantidade

        WHERE id_produto =
              p_id_produto;

    END IF;


    INSERT INTO movimentacao_estoque (
        id_produto,
        id_usuario,
        tipo,
        quantidade,
        motivo
    )

    VALUES (
        p_id_produto,
        p_id_usuario,
        p_tipo,
        p_quantidade,
        p_motivo
    );

END;
$$;


-- ============================================================
-- 28. VIEW DE ESTOQUE
-- ============================================================

CREATE OR REPLACE VIEW vw_estoque AS

SELECT
    p.id_produto,
    p.codigo,
    p.nome,

    c.nome AS categoria,

    u.sigla AS unidade,

    COALESCE(
        e.quantidade_atual,
        0
    ) AS quantidade_atual,

    p.estoque_minimo,

    p.preco_venda,

    CASE
        WHEN COALESCE(
            e.quantidade_atual,
            0
        ) <= p.estoque_minimo
            THEN 'ESTOQUE BAIXO'

        ELSE 'NORMAL'
    END AS situacao

FROM produto p

JOIN categoria c
    ON c.id_categoria = p.id_categoria

JOIN unidade_medida u
    ON u.id_unidade = p.id_unidade

LEFT JOIN estoque e
    ON e.id_produto = p.id_produto

WHERE p.ativo = TRUE;


-- ============================================================
-- 29. VIEW DE COMPRAS
-- ============================================================

CREATE OR REPLACE VIEW vw_compras AS

SELECT
    c.id_compra,
    c.data_compra,
    c.status,

    f.razao_social AS fornecedor,
    f.cnpj,

    COALESCE(
        SUM(
            (ic.quantidade * ic.valor_unitario)
            - ic.desconto
        ),
        0
    ) AS total_compra

FROM compra c

JOIN fornecedor f
    ON f.id_fornecedor = c.id_fornecedor

LEFT JOIN item_compra ic
    ON ic.id_compra = c.id_compra

GROUP BY
    c.id_compra,
    c.data_compra,
    c.status,
    f.razao_social,
    f.cnpj;


-- ============================================================
-- 30. VIEW DE VENDAS (ALTERADA: junção com cliente.id)
-- ============================================================

CREATE OR REPLACE VIEW vw_vendas AS

SELECT
    v.id_venda,
    v.data_venda,
    v.status,

    COALESCE(
        c.nome,
        'CONSUMIDOR NÃO IDENTIFICADO'
    ) AS cliente,

    COALESCE(
        SUM(
            (iv.quantidade * iv.valor_unitario)
            - iv.desconto
        ),
        0
    ) - v.desconto AS total_venda

FROM venda v

LEFT JOIN cliente c
    ON c.id = v.id_cliente

LEFT JOIN item_venda iv
    ON iv.id_venda = v.id_venda

GROUP BY
    v.id_venda,
    v.data_venda,
    v.status,
    c.nome,
    v.desconto;


