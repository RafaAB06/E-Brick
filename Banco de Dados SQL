-- ============================================================
-- 43. TODAS AS PERMISSOES PARA O ADMINISTRADOR
-- ============================================================

INSERT INTO perfil_permissao (
    id_perfil,
    id_permissao
)

SELECT
    p.id_perfil,
    pe.id_permissao

FROM perfil p

CROSS JOIN permissao pe

WHERE p.nome = 'ADMINISTRADOR';


-- ============================================================
-- 44. PERMISSOES DO VENDEDOR
-- ============================================================

INSERT INTO perfil_permissao (
    id_perfil,
    id_permissao
)

SELECT
    p.id_perfil,
    pe.id_permissao

FROM perfil p

JOIN permissao pe
    ON pe.nome IN (
        'CADASTRAR_CLIENTE',
        'EDITAR_CLIENTE',
        'REALIZAR_VENDA',
        'CONSULTAR_ESTOQUE'
    )

WHERE p.nome = 'VENDEDOR';


