-- ============================================================
-- 12. SELECTS DOS RELATÓRIOS
-- ============================================================

-- ------------------------------------------------------------
-- R01. Vendas por período (view vw_vendas)
-- ------------------------------------------------------------
SELECT id_venda, data_venda, status, cliente, total_venda
FROM vw_vendas
WHERE data_venda >= CURRENT_DATE - INTERVAL '30 days'
  AND status = 'FINALIZADA'
ORDER BY data_venda DESC;

-- ------------------------------------------------------------
-- R02. Itens de uma venda (nota/comprovante)  -> parâmetro: id_venda
-- ------------------------------------------------------------
SELECT id_venda, codigo, produto, unidade, quantidade,
       valor_unitario, desconto, subtotal
FROM vw_venda_itens
WHERE id_venda = 1
ORDER BY produto;

-- ------------------------------------------------------------
-- R03. Desempenho por vendedor e mês
-- ------------------------------------------------------------
SELECT vendedor, mes, qtd_vendas, total_vendido, ticket_medio
FROM vw_vendas_por_vendedor
ORDER BY mes DESC, total_vendido DESC;

-- ------------------------------------------------------------
-- R04. Top 10 produtos mais vendidos
-- ------------------------------------------------------------
SELECT codigo, produto, categoria, unidade, qtd_vendida, receita
FROM vw_produtos_mais_vendidos
ORDER BY qtd_vendida DESC
LIMIT 10;

-- ------------------------------------------------------------
-- R05. Faturamento por forma de pagamento
-- ------------------------------------------------------------
SELECT forma_pagamento, mes, qtd_pagamentos, total_recebido
FROM vw_faturamento_forma_pagamento
ORDER BY mes DESC, total_recebido DESC;

-- ------------------------------------------------------------
-- R06. Produtos com estoque baixo (reposição)
-- ------------------------------------------------------------
SELECT codigo, nome, categoria, unidade,
       quantidade_atual, estoque_minimo,
       (estoque_minimo - quantidade_atual) AS faltante
FROM vw_estoque_baixo
ORDER BY faltante DESC;

-- ------------------------------------------------------------
-- R07. Valor do estoque por categoria (a preço de venda)
-- ------------------------------------------------------------
SELECT categoria,
       COUNT(*)                          AS qtd_produtos,
       SUM(quantidade_atual)             AS itens_em_estoque,
       SUM(quantidade_atual * preco_venda) AS valor_estoque
FROM vw_estoque
GROUP BY categoria
ORDER BY valor_estoque DESC;

-- ------------------------------------------------------------
-- R08. Compras por fornecedor
-- ------------------------------------------------------------
SELECT fornecedor, cnpj, qtd_compras, total_comprado, ultima_compra
FROM vw_compras_por_fornecedor
ORDER BY total_comprado DESC;

-- ------------------------------------------------------------
-- R09. Histórico de movimentação de um produto  -> parâmetro: código
-- ------------------------------------------------------------
SELECT data_movimentacao, tipo, quantidade, responsavel, motivo
FROM vw_movimentacao_detalhada
WHERE codigo = 'CIM001'
ORDER BY data_movimentacao DESC;

-- ------------------------------------------------------------
-- R10. Vendas com saldo em aberto (contas a receber)
-- ------------------------------------------------------------
SELECT id_venda, data_venda, cliente, total_venda, total_pago, saldo_aberto
FROM vw_pagamentos_por_venda
WHERE status <> 'CANCELADA'
  AND saldo_aberto > 0
ORDER BY data_venda;

-- ------------------------------------------------------------
-- R11. Ficha de clientes com CPF/CNPJ
-- ------------------------------------------------------------
SELECT id, tipo_pessoa, nome, documento, telefone, email, cidade, estado
FROM vw_clientes_completo
WHERE ativo
ORDER BY nome;

-- ------------------------------------------------------------
-- R12. Ranking de clientes por valor comprado (JOIN cliente x vendas)
-- ------------------------------------------------------------
SELECT cc.nome, cc.documento,
       COUNT(vv.id_venda)  AS qtd_compras,
       SUM(vv.total_venda) AS total_gasto
FROM vw_clientes_completo cc
JOIN venda v      ON v.id_cliente = cc.id
JOIN vw_vendas vv ON vv.id_venda = v.id_venda
WHERE v.status = 'FINALIZADA'
GROUP BY cc.nome, cc.documento
ORDER BY total_gasto DESC;

-- ------------------------------------------------------------
-- R13. Produtos sem venda nos últimos 90 dias
-- ------------------------------------------------------------
SELECT p.codigo, p.nome, c.nome AS categoria, e.quantidade_atual
FROM produto p
JOIN categoria c   ON c.id_categoria = p.id_categoria
LEFT JOIN estoque e ON e.id_produto = p.id_produto
WHERE p.ativo
  AND NOT EXISTS (
        SELECT 1
        FROM item_venda iv
        JOIN venda v ON v.id_venda = iv.id_venda
        WHERE iv.id_produto = p.id_produto
          AND v.status = 'FINALIZADA'
          AND v.data_venda >= CURRENT_DATE - INTERVAL '90 days'
  )
ORDER BY p.nome;
