-- ============================================================
-- 41. PERFIL DO ADMINISTRADOR
-- ============================================================

INSERT INTO usuario_perfil (
    id_usuario,
    id_perfil
)

SELECT
    u.id_usuario,
    p.id_perfil

FROM usuario u

JOIN perfil p
    ON p.nome = 'ADMINISTRADOR'

WHERE u.login = 'admin';


