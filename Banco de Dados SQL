GRANT EXECUTE ON PROCEDURE sp_receber_compra(BIGINT)   TO grp_admin, grp_gerente, grp_estoque;
GRANT EXECUTE ON PROCEDURE sp_registrar_ajuste_estoque(BIGINT, BIGINT, VARCHAR, NUMERIC, VARCHAR)
    TO grp_admin, grp_gerente, grp_estoque;
GRANT EXECUTE ON PROCEDURE sp_cadastrar_cliente(VARCHAR, VARCHAR, VARCHAR, VARCHAR, VARCHAR, VARCHAR, VARCHAR, CHAR, BIGINT)
    TO grp_admin, grp_gerente, grp_vendedor, grp_atendente;


