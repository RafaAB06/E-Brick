package br.edu.unoesc.ebrick.main;

import java.io.IOException;
import java.sql.SQLException;

import br.edu.unoesc.ebrick.auth.Usuarios;
import br.edu.unoesc.ebrick.http.HttpUtils;
import br.edu.unoesc.ebrick.http.Server;
import br.edu.unoesc.ebrick.http.handlers.FileHandler;
import br.edu.unoesc.ebrick.http.handlers.HandlerPadrao;
import br.edu.unoesc.ebrick.http.handlers.LoginHandler;
import br.edu.unoesc.ebrick.http.handlers.SistemaHandler;
import br.edu.unoesc.ebrick.sql.SqlConnection;

public class Main {
	public static void main(String[] args) {
		if(iniciarBanco()) {
			if(iniciarUsuarios()) {
				if(iniciarServidor()) {
					System.out.println("Tudo ok!");
				}else System.exit(1);
			}else System.exit(1);
		}else System.exit(1);
	}

	private static boolean iniciarBanco() {
		boolean sucess = true;
		
		try {
			SqlConnection.connect("jdbc:postgresql://localhost:5432/ebrick", "postgres", "postgres");
		}catch(SQLException e) {
			System.out.println("Falha ao conectar ao banco!");
			e.printStackTrace();
			
			sucess = false;
		}
		return sucess;
	}

	private static boolean iniciarUsuarios() {
		boolean sucess = true;
		try {
			Usuarios.getInstancia().inicializar();;//importante, sem isso tudo entra em colapso
		}catch(SQLException e) {
			System.out.println("Falha ao buscar usuarios!");
			e.printStackTrace();
			
			sucess = false;
		}
		return sucess;
	}

	private static boolean iniciarServidor() {
		boolean sucess = true;
		try {
			Server.start(8080);
			Server.addListener("/", new HandlerPadrao());
			Server.addListener("/login", new LoginHandler());	
			Server.addListener(new SistemaHandler("/sistema"));	
			//Server.addListener("/cadastro_cliente", new CadastroHandler());
			
			Server.addListener("/lib.js", new FileHandler("web/lib.js", HttpUtils.TEXT_JAVASCRIPT));
			
		}catch(IOException e) {
			System.out.println("Falha ao iniciar servidor!");//omaigá
			e.printStackTrace();
			
			sucess = false;
		}
		return sucess;
	}
}
